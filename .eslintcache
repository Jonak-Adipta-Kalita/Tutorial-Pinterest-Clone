gCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"22"},{"filePath":"32","messages":"33","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"22"},{"filePath":"34","messages":"35","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"22"},{"filePath":"36","messages":"37","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"22"},{"filePath":"38","messages":"39","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"F:\\Hard-disk\\Project\\Works\\JAK Pinterest Clone\\src\\index.js",[],["40","41"],"F:\\Hard-disk\\Project\\Works\\JAK Pinterest Clone\\src\\app\\store.js",[],"F:\\Hard-disk\\Project\\Works\\JAK Pinterest Clone\\src\\serviceWorker.js",[],"F:\\Hard-disk\\Project\\Works\\JAK Pinterest Clone\\src\\App.js",["42"],"import React, { useState, useEffect } from 'react';\r\nimport Header from './components/Header';\r\nimport Mainboard from './components/Mainboard';\r\nimport unsplash from './api/unsplash';\r\n\r\nfunction App() {\r\n\tconst [pins, setNewPins] = useState([]);\r\n\tconst getImages = (term) => {\r\n\t\treturn unsplash.get(\"https://api.unsplash.com/search/photos\", {\r\n\t\t\tparams: {\r\n\t\t\t\tquery: term\r\n\t\t\t}\r\n\t\t});\r\n\t};\r\n\tconst onSearchSubmit = (term) => {\r\n\t\tgetImages(term).then((res) => {\r\n\t\t\tlet results = res.data.results;\r\n\t\t\tlet newPins = [\r\n\t\t\t\t...results,\r\n\t\t\t\t...pins,\r\n\t\t\t]\r\n\t\t\tnewPins.sort(function(a, b) {\r\n\t\t\t\treturn 0.5 - Math.random();\r\n\t\t\t});\r\n\t\t\tsetNewPins(newPins);\r\n\t\t})\r\n\t};\r\n\tconst getNewPins = () => {\r\n\t\tlet promises = [];\r\n\t\tlet pinData = [];\r\n\t\tlet pins = ['oceans', 'car', 'cat', 'dog', 'bali']\r\n\t\tpins.forEach((pinTerms) => {\r\n\t\t\tpromises.push(\r\n\t\t\t\tgetImages(pinTerms).then((res) => {\r\n\t\t\t\t\tlet results = res.data.results;\r\n\t\t\t\t\tpinData = pinData.concat(results);\r\n\t\t\t\t\tpinData.sort(function(a, b) {\r\n\t\t\t\t\t\treturn 0.5 - Math.random();\r\n\t\t\t\t\t});\r\n\t\t\t\t})\r\n\t\t\t)\r\n\t\t})\r\n\t\tPromise.all(promises).then(() => {\r\n\t\t\tsetNewPins(pinData);\r\n\t\t})\r\n\t};\r\n\tuseEffect(() => {\r\n\t\tgetNewPins()\r\n\t}, [])\r\n\treturn (\r\n\t\t<div className=\"App\">\r\n\t\t\t<Header \r\n\t\t\t\tonSubmit={onSearchSubmit}\r\n\t\t\t/>\r\n\t\t\t<Mainboard \r\n\t\t\t\tpins={pins}\r\n\t\t\t/>\r\n\t\t</div>\r\n\t);\r\n}\r\n\r\nexport default App;\r\n","F:\\Hard-disk\\Project\\Works\\JAK Pinterest Clone\\src\\components\\Mainboard.js",[],"F:\\Hard-disk\\Project\\Works\\JAK Pinterest Clone\\src\\components\\Header.js",[],"F:\\Hard-disk\\Project\\Works\\JAK Pinterest Clone\\src\\api\\unsplash.js",[],"F:\\Hard-disk\\Project\\Works\\JAK Pinterest Clone\\src\\features\\counter\\counterSlice.js",[],"F:\\Hard-disk\\Project\\Works\\JAK Pinterest Clone\\src\\components\\Pin.js",[],{"ruleId":"43","replacedBy":"44"},{"ruleId":"45","replacedBy":"46"},{"ruleId":"47","severity":1,"message":"48","line":49,"column":5,"nodeType":"49","endLine":49,"endColumn":7,"suggestions":"50"},"no-native-reassign",["51"],"no-negated-in-lhs",["52"],"react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'getNewPins'. Either include it or remove the dependency array.","ArrayExpression",["53"],"no-global-assign","no-unsafe-negation",{"desc":"54","fix":"55"},"Update the dependencies array to be: [getNewPins]",{"range":"56","text":"57"},[1184,1186],"[getNewPins]"]